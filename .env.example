# ══════════════════════════════════════════════════════════════════════════════
#  ASPHALIX  —  asphalix.com  (formerly Sakha AI / Sakha InfoTech)
#  Copy to `.env` and fill in.  NEVER commit `.env`.
# ══════════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
# Public origin of the site. Used for cookies, CORS, sitemap, canonical URLs.
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to 1 when running behind Nginx / any reverse proxy so req.ip is correct.
TRUST_PROXY=1

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=asphalix
POSTGRES_PASSWORD=asphalix_dev_password_change_me
POSTGRES_DB=asphalix
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://asphalix:asphalix_dev_password_change_me@localhost:5432/asphalix?schema=public"
# Connection pool ceiling for Prisma (per process).
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: response cache, rate limiting, session/refresh-token revocation,
# BullMQ job queues, distributed locks, and pub/sub cache invalidation.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=asphalix
# Default TTL (seconds) for cached public content responses.
CACHE_TTL_SECONDS=300

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie domain in production, e.g. .asphalix.com  (leave blank for localhost)
COOKIE_DOMAIN=
# Argon2id tuning. Raise memoryCost on beefier hardware.
ARGON_MEMORY_COST=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# ── Rate limiting (Redis-backed, sliding window) ──────────────────────────────
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH_MAX=8
RATE_LIMIT_AUTH_WINDOW=300
RATE_LIMIT_SAKHA_ANON_MAX=15
RATE_LIMIT_SAKHA_ANON_WINDOW=3600
RATE_LIMIT_SAKHA_USER_MAX=120
RATE_LIMIT_SAKHA_USER_WINDOW=3600
RATE_LIMIT_LEAD_MAX=5
RATE_LIMIT_LEAD_WINDOW=3600

# ══════════════════════════════════════════════════════════════════════════════
#  SAKHA — the intelligence engine
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM provider (Groq) ───────────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Main reasoning + tool-calling model.
GROQ_MODEL=openai/gpt-oss-120b
# Cheaper model for query rewriting, summarisation and title generation.
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Answers with this model when the main one hits its per-minute limit (it has
# its own allowance). Leave empty to fail instead of switching.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Reply budget per call, hidden reasoning included. Groq counts it against the
# per-minute limit even when unused; real replies have peaked at ~430 tokens.
GROQ_MAX_TOKENS=800
GROQ_TEMPERATURE=0.25
# How many tool-call round trips Sakha may take before it must answer.
SAKHA_MAX_TOOL_STEPS=5
# Hard ceiling on turns kept in a single conversation's context window.
SAKHA_HISTORY_TURNS=12
# Rough ceiling, in tokens, on one request to the model. Groq's free tier allows
# 8,000 tokens a minute per model and counts GROQ_MAX_TOKENS against it too.
# Older history is dropped to stay under it, and once tool results fill it
# Sakha must answer with what it has. Raise it on a paid tier.
SAKHA_PROMPT_TOKEN_BUDGET=6000

# ── Knowledge base refresh ────────────────────────────────────────────────────
# Full rebuild cadence in hours. Set to 1 for hourly. CMS publishes are ALWAYS
# indexed instantly regardless of this value (live update path).
KNOWLEDGE_REFRESH_HOURS=10
# Comma-separated public URLs Sakha is allowed to crawl. robots.txt is honoured.
# These are seeded into the database DISABLED. Turn each one on from
# Admin -> Knowledge only once that URL actually serves your site — crawling a
# domain you have not launched yet just indexes the registrar's parking page.
KNOWLEDGE_CRAWL_URLS=https://asphalix.com,https://asphalix.com/services,https://asphalix.com/work
KNOWLEDGE_CRAWL_MAX_PAGES=40
KNOWLEDGE_CRAWL_TIMEOUT_MS=15000
KNOWLEDGE_CRAWL_USER_AGENT="AsphalixBot/1.0 (+https://asphalix.com/bot)"
# Local markdown knowledge directory (relative to repo root).
KNOWLEDGE_DOCS_DIR=content/knowledge
# Retrieval tuning
KNOWLEDGE_CHUNK_TOKENS=350
KNOWLEDGE_CHUNK_OVERLAP=60
KNOWLEDGE_TOP_K=8

# ── Embeddings (optional) ─────────────────────────────────────────────────────
# Retrieval works out of the box with Postgres full-text + trigram search.
# Set a provider to additionally enable dense vector search via pgvector.
#   none   — lexical retrieval only (default, zero cost, no extra keys)
#   openai — uses OPENAI_API_KEY with text-embedding-3-small
EMBEDDING_PROVIDER=none
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# ── Email (optional; leave blank to log to console instead of sending) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Asphalix <hello@asphalix.com>"
# Where new lead / contact notifications go.
LEADS_NOTIFY_TO=malarvizhi@asphalix.com
# Where new and updated support tickets are emailed. Falls back to LEADS_NOTIFY_TO.
SUPPORT_NOTIFY_TO=support@asphalix.com

# ── Seed accounts (used by `npm run db:seed` only) ────────────────────────────
SEED_SUPERADMIN_EMAIL=gokul@asphalix.com
SEED_SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1
SEED_ADMIN_BD_EMAIL=malarvizhi@asphalix.com
SEED_ADMIN_BD_PASSWORD=ChangeMe!Admin1

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=apps/api/uploads
UPLOAD_MAX_BYTES=8388608

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Pretty-print logs in dev; set to false for JSON lines in production.
LOG_PRETTY=true
