{
  "name": "@sakha/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/server.js",
    "start": "node src/server.js",
    "worker": "node --env-file=../../.env src/jobs/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "node --env-file=../../.env prisma/seed.js",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "knowledge:reindex": "node --env-file=../../.env src/scripts/reindex.js",
    "test": "node --test --env-file=../../.env \"test/*.test.js\"",
    "test:integration": "node --test --env-file=../../.env \"test/*.integration.js\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sakha/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.3"
  }
}
